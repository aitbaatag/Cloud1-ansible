DOMAIN_NAME={{ site_host }}

# Database configuration
MYSQL_ROOT_PASSWORD={{ vault_db_root_password }}
MYSQL_DATABASE={{ db_name }}
MYSQL_USER={{ db_user }}
MYSQL_PASSWORD={{ vault_db_password }}

# WordPress database configuration
WORDPRESS_DB_HOST={{ db_host }}
WORDPRESS_DB_USER={{ db_user }}
WORDPRESS_DB_PASSWORD={{ vault_db_password }}
WORDPRESS_DB_NAME={{ db_name }}

# WordPress admin configuration
WORDPRESS_SITE_URL=https://{{ site_host }}
WORDPRESS_SITE_TITLE="{{ wp_site_title }}"
WORDPRESS_ADMIN_USER={{ wp_admin_user }}
WORDPRESS_ADMIN_PASSWORD={{ vault_wp_admin_password }}
WORDPRESS_ADMIN_EMAIL={{ wp_admin_email }}

# WordPress user configuration
WORDPRESS_USER={{ wp_user }}
WORDPRESS_USER_PASSWORD={{ vault_wp_user_password }}
WORDPRESS_USER_EMAIL={{ wp_user_email }}
